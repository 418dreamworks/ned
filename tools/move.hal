# move.hal -- loaded by move.sh (don't run directly). FULLY STANDALONE: move.sh kills
# LinuxCNC + any HAL session first, then loads this. ONE command per line (HAL syntax).
# Configures EVERYTHING move.sh can drive:
#   stepgen.00/.01 = workpiece rotary pair (velocity mode; `move.sh rotary`)
#   stepgen.02     = A head TILT  (/S-ON = 7I84 output-06)   scale 8192 = Pn20E 8192/Pn210 1
#   stepgen.03     = C head SPIN  (/S-ON = 7I84 output-07)   (26-bit enc / 8192)
#   pwmgen.00-03   = X/Y/Z/W servo analog, BIPOLAR offset-PWM recipe (75 kHz + dither
#                    + offset-mode, per ned.hal CONFIRMED 2026-06-25), scales 50/50/40/50
#   pwmgen.04      = spindle VFD analog, UNIPOLAR 0..10 V, scale 24000 RPM = 10 V
loadrt hostmot2
loadrt hm2_eth board_ip="10.10.10.10" config="num_encoders=6 num_pwmgens=6 num_stepgens=4 num_inmuxs=1 sserial_port_0=0xxxxxxx"
loadrt threads name1=servo period1=1000000
addf hm2_7i97.0.read  servo
addf hm2_7i97.0.write servo
setp hm2_7i97.0.watchdog.timeout_ns 1000000000

# ---------------- stepgens (velocity mode; scale = pulses per motor rev) ----------------
setp hm2_7i97.0.stepgen.00.step_type 0
setp hm2_7i97.0.stepgen.00.control-type 1
setp hm2_7i97.0.stepgen.00.position-scale 400
setp hm2_7i97.0.stepgen.00.steplen 2500
setp hm2_7i97.0.stepgen.00.stepspace 2500
setp hm2_7i97.0.stepgen.00.dirsetup 20000
setp hm2_7i97.0.stepgen.00.dirhold 20000
setp hm2_7i97.0.stepgen.00.maxvel 200
setp hm2_7i97.0.stepgen.00.maxaccel 3

setp hm2_7i97.0.stepgen.01.step_type 0
setp hm2_7i97.0.stepgen.01.control-type 1
setp hm2_7i97.0.stepgen.01.position-scale 400
setp hm2_7i97.0.stepgen.01.steplen 2500
setp hm2_7i97.0.stepgen.01.stepspace 2500
setp hm2_7i97.0.stepgen.01.dirsetup 20000
setp hm2_7i97.0.stepgen.01.dirhold 20000
setp hm2_7i97.0.stepgen.01.maxvel 200
setp hm2_7i97.0.stepgen.01.maxaccel 3

setp hm2_7i97.0.stepgen.02.step_type 0
setp hm2_7i97.0.stepgen.02.control-type 1
setp hm2_7i97.0.stepgen.02.position-scale 8192
setp hm2_7i97.0.stepgen.02.steplen 2500
setp hm2_7i97.0.stepgen.02.stepspace 2500
setp hm2_7i97.0.stepgen.02.dirsetup 20000
setp hm2_7i97.0.stepgen.02.dirhold 20000
setp hm2_7i97.0.stepgen.02.maxvel 50
setp hm2_7i97.0.stepgen.02.maxaccel 3

setp hm2_7i97.0.stepgen.03.step_type 0
setp hm2_7i97.0.stepgen.03.control-type 1
setp hm2_7i97.0.stepgen.03.position-scale 8192
setp hm2_7i97.0.stepgen.03.steplen 2500
setp hm2_7i97.0.stepgen.03.stepspace 2500
setp hm2_7i97.0.stepgen.03.dirsetup 20000
setp hm2_7i97.0.stepgen.03.dirhold 20000
setp hm2_7i97.0.stepgen.03.maxvel 50
setp hm2_7i97.0.stepgen.03.maxaccel 3

# ---------------- pwmgens (mirrors ned.hal's confirmed recipe) --------------------------
setp hm2_7i97.0.pwmgen.00.output-type 1
setp hm2_7i97.0.pwmgen.01.output-type 1
setp hm2_7i97.0.pwmgen.02.output-type 1
setp hm2_7i97.0.pwmgen.03.output-type 1
setp hm2_7i97.0.pwmgen.04.output-type 1
setp hm2_7i97.0.pwmgen.00.offset-mode 1
setp hm2_7i97.0.pwmgen.01.offset-mode 1
setp hm2_7i97.0.pwmgen.02.offset-mode 1
setp hm2_7i97.0.pwmgen.03.offset-mode 1
setp hm2_7i97.0.pwmgen.04.offset-mode 0
setp hm2_7i97.0.pwmgen.00.dither 1
setp hm2_7i97.0.pwmgen.01.dither 1
setp hm2_7i97.0.pwmgen.02.dither 1
setp hm2_7i97.0.pwmgen.03.dither 1
setp hm2_7i97.0.pwmgen.04.dither 1
setp hm2_7i97.0.pwmgen.00.scale 50
setp hm2_7i97.0.pwmgen.01.scale 50
setp hm2_7i97.0.pwmgen.02.scale 40
setp hm2_7i97.0.pwmgen.03.scale 50
setp hm2_7i97.0.pwmgen.04.scale 24000
setp hm2_7i97.0.pwmgen.pwm_frequency 75000

start

setp hm2_7i97.0.stepgen.00.enable 0
setp hm2_7i97.0.stepgen.01.enable 0
setp hm2_7i97.0.stepgen.02.enable 0
setp hm2_7i97.0.stepgen.03.enable 0
setp hm2_7i97.0.stepgen.00.velocity-cmd 0
setp hm2_7i97.0.stepgen.01.velocity-cmd 0
setp hm2_7i97.0.stepgen.02.velocity-cmd 0
setp hm2_7i97.0.stepgen.03.velocity-cmd 0
setp hm2_7i97.0.pwmgen.00.enable 0
setp hm2_7i97.0.pwmgen.01.enable 0
setp hm2_7i97.0.pwmgen.02.enable 0
setp hm2_7i97.0.pwmgen.03.enable 0
setp hm2_7i97.0.pwmgen.04.enable 0
setp hm2_7i97.0.pwmgen.00.value 0
setp hm2_7i97.0.pwmgen.01.value 0
setp hm2_7i97.0.pwmgen.02.value 0
setp hm2_7i97.0.pwmgen.03.value 0
setp hm2_7i97.0.pwmgen.04.value 0

# hold the session open until move.sh tears it down
loadusr -w sleep 100000
