# spin-both-fast.hal — spin BOTH B steppers in velocity mode, opposite directions.
#   stepgen.00 (TB2 11-14) forward, stepgen.01 (TB2 19-22) reverse -> counter-rotate.
# NC R11 keeps the bricks powered with drive-enable LOW. Stop LinuxCNC/other halrun first.
# Run:  halrun -I -f ~/spin-both-fast.hal
#
# It starts both at ~1 rev/s opposite. At the halcmd: prompt, crank the speed:
#   setp hm2_7i97.0.stepgen.00.velocity-cmd 3
#   setp hm2_7i97.0.stepgen.01.velocity-cmd -3
#   ...raise the magnitude (keep 01 negative) until they buzz/stall, then back off.
#   stop both:  setp hm2_7i97.0.stepgen.00.velocity-cmd 0 ; setp hm2_7i97.0.stepgen.01.velocity-cmd 0
#   quit:       exit
#
# NOTE: position-scale below = 3200 = your CURRENT drive pulses/rev, so velocity-cmd
# is in motor rev/s. If you drop the drives to 200 pulses/rev (full step) for max
# speed, change both position-scale lines from 3200 to 200.

loadrt hostmot2
loadrt hm2_eth board_ip="10.10.10.10" config="num_encoders=6 num_pwmgens=6 num_stepgens=4 num_inmuxs=1 sserial_port_0=0xxxxxxx"
loadrt threads name1=servo period1=1000000
addf hm2_7i97.0.read  servo
addf hm2_7i97.0.write servo
setp hm2_7i97.0.watchdog.timeout_ns 1000000000

setp hm2_7i97.0.stepgen.00.step_type       0
setp hm2_7i97.0.stepgen.00.control-type    1
setp hm2_7i97.0.stepgen.00.position-scale  400
setp hm2_7i97.0.stepgen.00.steplen         2500
setp hm2_7i97.0.stepgen.00.stepspace       2500
setp hm2_7i97.0.stepgen.00.dirsetup        20000
setp hm2_7i97.0.stepgen.00.dirhold         20000
setp hm2_7i97.0.stepgen.00.maxvel          20
setp hm2_7i97.0.stepgen.00.maxaccel        5

setp hm2_7i97.0.stepgen.01.step_type       0
setp hm2_7i97.0.stepgen.01.control-type    1
setp hm2_7i97.0.stepgen.01.position-scale  400
setp hm2_7i97.0.stepgen.01.steplen         2500
setp hm2_7i97.0.stepgen.01.stepspace       2500
setp hm2_7i97.0.stepgen.01.dirsetup        20000
setp hm2_7i97.0.stepgen.01.dirhold         20000
setp hm2_7i97.0.stepgen.01.maxvel          20
setp hm2_7i97.0.stepgen.01.maxaccel        5

start
setp hm2_7i97.0.stepgen.00.enable          1
setp hm2_7i97.0.stepgen.01.enable          1
setp hm2_7i97.0.stepgen.00.velocity-cmd    1
setp hm2_7i97.0.stepgen.01.velocity-cmd   -1
