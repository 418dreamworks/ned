      </item>
      <item>
       <layout class="QGridLayout" name="jp_grid">
        <property name="horizontalSpacing"><number>4</number></property>
        <property name="verticalSpacing"><number>4</number></property>
        <item row="0" column="0">
         <widget class="QPushButton" name="jp_p_xy0">
          <property name="text"><string>XY 0
X0 Y0</string></property>
