<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ned_controls</class>
 <!-- JOG & PRESETS panel v2, NARROW SQUEEZE (2026-08-02): single 200 px
      column sized for the STOCK JOG PAGE of PB's right sidebar stack
      (probe_basic.ui sidebar_widget > sb_page_1 > jogDisplay, ~200x730).
      All widgets/layouts are declared HERE (no runtime layout insertion
      -> no QGridLayout insertWidget hazard); ned_controls.py only
      findChild()s + connects and logs the wired/missing count loudly.
      Styling: one panel-level QSS on jp_panel using #objectName selectors
      (dark + amber). Same 21 _JOG_WIDGETS names as the wide v2 layout;
      deltas are geometry only: SPEED buttons stacked vertically, presets
      2 cols x 3 rows, typed-move fields full-width (axis+unit live in the
      placeholder, jp_lbl_*/jp_unit_* labels deleted), CLEAR + GO ABS +
      GO REL stacked full-width, status strip + full-width STOP at the
      bottom. Tap-target fonts >= 9pt. -->
 <widget class="QWidget" name="ned_controls_root">
  <layout class="QVBoxLayout" name="nedLayout">
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <property name="spacing"><number>0</number></property>
   <item>
    <widget class="QFrame" name="jp_panel">
     <property name="styleSheet"><string notr="true">
#jp_panel { background: rgb(24,27,31); border: none; border-radius: 6px; }
QLabel { background: transparent; color: rgb(148,155,163); }
#jp_title { font: 75 9pt; color: rgb(148,155,163); }
#jp_speed_caption, #jp_presets_caption, #jp_typed_caption {
  font: 75 8pt; color: rgb(148,155,163); }
#jp_feed_readout { font: 75 8pt; color: rgb(232,166,53); }
#jp_presets_note { font: 8pt; color: rgb(110,117,124); }
QPushButton { background: rgb(43,48,54); color: rgb(214,218,222);
  border: 1px solid rgb(72,79,87); border-radius: 5px; font: 75 10pt; }
QPushButton:pressed { background: rgb(60,66,73); }
QPushButton:disabled { background: rgb(34,38,43);
  color: rgb(105,111,118); border-color: rgb(55,60,66); }
#jp_slow:checked, #jp_medium:checked, #jp_fast:checked {
  background: rgb(232,166,53); color: rgb(20,20,20);
  border-color: rgb(232,166,53); }
#jp_p_xy0, #jp_p_xyz0, #jp_p_z0, #jp_p_zp10, #jp_p_xy0z10, #jp_p_a0c0 {
  font: 75 9pt; }
QLineEdit { background: rgb(28,32,36); color: white;
  border: 1px solid rgb(72,79,87); border-radius: 5px;
  padding: 2px 6px; font: 10pt;
  selection-background-color: rgb(232,166,53); }
QLineEdit:focus { border: 1px solid rgb(232,166,53); }
#jp_go_abs, #jp_go_rel { background: rgb(32,30,24);
  color: rgb(232,166,53); border: 1px solid rgb(232,166,53);
  font: 75 10pt; }
#jp_go_abs:pressed, #jp_go_rel:pressed { background: rgb(60,50,30); }
#jp_go_abs:disabled, #jp_go_rel:disabled { background: rgb(30,31,33);
  color: rgb(115,102,75); border-color: rgb(85,78,60); }
#jp_status_dot { color: rgb(80,200,120); font: 11pt; }
#jp_status_text { color: rgb(148,155,163); font: 9pt; }
#jp_stop { background: transparent; color: rgb(220,90,90);
  border: 1px solid rgb(200,80,80); font: 75 10pt; }
#jp_stop:pressed { background: rgb(70,32,32); }
#jp_stop:disabled { background: transparent; color: rgb(110,80,80);
  border-color: rgb(80,60,60); }
     </string></property>
     <layout class="QVBoxLayout" name="jp_v">
      <property name="leftMargin"><number>8</number></property>
      <property name="topMargin"><number>8</number></property>
      <property name="rightMargin"><number>8</number></property>
      <property name="bottomMargin"><number>8</number></property>
      <property name="spacing"><number>4</number></property>
      <item>
