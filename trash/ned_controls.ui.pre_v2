<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ned_controls</class>
 <!-- JOG & PRESETS panel (operator mockup 2026-08-01). All widgets/layouts are
      declared HERE (no runtime layout insertion anywhere -> no QGridLayout
      insertWidget hazard); ned_controls.py only findChild()s + connects and
      logs the wired/missing count loudly. Styling: one panel-level QSS on
      jp_panel using #objectName selectors (dark + amber, mockup palette). -->
 <widget class="QWidget" name="ned_controls_root">
  <layout class="QVBoxLayout" name="nedLayout">
   <property name="leftMargin"><number>12</number></property>
   <property name="topMargin"><number>12</number></property>
   <property name="rightMargin"><number>12</number></property>
   <property name="bottomMargin"><number>12</number></property>
   <item>
    <layout class="QHBoxLayout" name="jp_outer_h">
     <item>
      <widget class="QFrame" name="jp_panel">
       <property name="maximumSize"><size><width>500</width><height>16777215</height></size></property>
       <property name="styleSheet"><string notr="true">
#jp_panel { background: rgb(24,27,31); border: none; border-radius: 8px; }
QLabel { background: transparent; color: rgb(148,155,163); }
#jp_title, #jp_speed_caption, #jp_presets_caption, #jp_typed_caption {
  font: 75 10pt; color: rgb(148,155,163); }
#jp_feed_readout { font: 75 10pt; color: rgb(232,166,53); }
#jp_presets_note { font: 8pt; color: rgb(110,117,124); }
#jp_lbl_x, #jp_lbl_y, #jp_lbl_z, #jp_lbl_a, #jp_lbl_c {
  font: 75 12pt; color: rgb(214,218,222); }
#jp_unit_x, #jp_unit_y, #jp_unit_z, #jp_unit_a, #jp_unit_c {
  font: 8pt; color: rgb(110,117,124); }
QPushButton { background: rgb(43,48,54); color: rgb(214,218,222);
  border: 1px solid rgb(72,79,87); border-radius: 5px; font: 75 11pt; }
QPushButton:pressed { background: rgb(60,66,73); }
#jp_slow:checked, #jp_medium:checked, #jp_fast:checked {
  background: rgb(232,166,53); color: rgb(20,20,20);
  border-color: rgb(232,166,53); }
#jp_absrel_frame { background: rgb(30,34,39);
  border: 1px solid rgb(72,79,87); border-radius: 6px; }
#jp_abs, #jp_rel { background: transparent; border: none;
  color: rgb(130,137,144); font: 75 11pt; }
#jp_abs:checked, #jp_rel:checked { background: rgb(58,65,73);
  color: white; border-radius: 5px; }
#jp_p_xy0, #jp_p_xyz0, #jp_p_z0, #jp_p_zp10, #jp_p_xy0z10, #jp_p_a0c0 {
  text-align: left; padding-left: 10px; font: 75 11pt; }
#jp_typed_frame { background: transparent;
  border: 1px solid rgb(60,66,73); border-radius: 6px; }
QLineEdit { background: rgb(28,32,36); color: white;
  border: 1px solid rgb(72,79,87); border-radius: 5px;
  padding: 4px 8px; font: 11pt;
  selection-background-color: rgb(232,166,53); }
QLineEdit:focus { border: 1px solid rgb(232,166,53); }
#jp_go { background: rgb(32,30,24); color: rgb(232,166,53);
  border: 1px solid rgb(232,166,53); font: 75 12pt; }
#jp_go:pressed { background: rgb(60,50,30); }
       </string></property>
       <layout class="QVBoxLayout" name="jp_v">
        <property name="leftMargin"><number>14</number></property>
        <property name="topMargin"><number>12</number></property>
        <property name="rightMargin"><number>14</number></property>
        <property name="bottomMargin"><number>14</number></property>
        <property name="spacing"><number>10</number></property>
        <item>
         <widget class="QLabel" name="jp_title">
          <property name="text"><string>J O G   &amp;   P R E S E T S</string></property>
         </widget>
        </item>
        <item>
         <widget class="QFrame" name="jp_absrel_frame">
          <property name="minimumSize"><size><width>0</width><height>44</height></size></property>
          <layout class="QHBoxLayout" name="jp_absrel_h">
           <property name="leftMargin"><number>3</number></property>
           <property name="topMargin"><number>3</number></property>
           <property name="rightMargin"><number>3</number></property>
           <property name="bottomMargin"><number>3</number></property>
           <property name="spacing"><number>0</number></property>
           <item>
            <widget class="QPushButton" name="jp_abs">
             <property name="text"><string>ABSOLUTE</string></property>
             <property name="checkable"><bool>true</bool></property>
             <property name="checked"><bool>true</bool></property>
             <property name="minimumSize"><size><width>0</width><height>36</height></size></property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="jp_rel">
             <property name="text"><string>RELATIVE</string></property>
             <property name="checkable"><bool>true</bool></property>
