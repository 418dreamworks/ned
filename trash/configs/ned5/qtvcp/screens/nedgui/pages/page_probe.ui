<?xml version="1.0" encoding="UTF-8"?>
<!-- Probe panel: deploy the Bimba tool-probe and measure this tool's Z top.
     Buttons are ActionButtons running MDI (same mechanism the old cal page used).
     PRE (Find Z Top): homed, tool/rod in spindle, jog the rod roughly over the
     probe centre with the MPG, extend the probe, then Find Z Top. -->
<ui version="4.0">
 <class>pageProbe</class>
 <widget class="QWidget" name="pageProbe">
  <layout class="QVBoxLayout" name="probeLayout">
   <item>
    <widget class="QLabel" name="probe_hdr">
     <property name="text"><string>TOOL PROBE</string></property>
     <property name="styleSheet"><string notr="true">font: 75 15pt; padding: 6px;</string></property>
    </widget>
   </item>
   <item>
    <widget class="ActionButton" name="btn_probe_extend">
     <property name="minimumSize"><size><width>0</width><height>52</height></size></property>
     <property name="text"><string>EXTEND PROBE (M64 P3)</string></property>
     <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
     <property name="command_text_string" stdset="0"><string>M64 P3</string></property>
    </widget>
   </item>
   <item>
    <widget class="ActionButton" name="btn_probe_retract">
     <property name="minimumSize"><size><width>0</width><height>44</height></size></property>
     <property name="text"><string>RETRACT PROBE (M65 P3)</string></property>
     <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
     <property name="command_text_string" stdset="0"><string>M65 P3</string></property>
    </widget>
   </item>
   <item>
    <widget class="ActionButton" name="btn_find_ztop">
     <property name="minimumSize"><size><width>0</width><height>66</height></size></property>
     <property name="text"><string>FIND Z TOP  (probe this tool)</string></property>
     <property name="styleSheet"><string notr="true">font: 75 13pt;</string></property>
     <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
     <property name="command_text_string" stdset="0"><string>o&lt;find_puck_top&gt; call</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="lbl_ztop_result">
     <property name="text"><string>Z_top: (run Find Z Top)</string></property>
     <property name="styleSheet"><string notr="true">color: rgb(0,255,180); font: 75 15pt "Courier 10 Pitch"; padding: 6px;</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="sol_hdr">
     <property name="text"><string>SOLENOIDS  (individual on/off)</string></property>
     <property name="styleSheet"><string notr="true">font: 75 13pt; padding: 8px 6px 2px 6px;</string></property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="solGrid">
     <item row="0" column="0"><widget class="QLabel" name="sol_lbl_ts"><property name="text"><string>Tool probe (P3)</string></property></widget></item>
     <item row="0" column="1">
      <widget class="ActionButton" name="btn_sol_ts_on">
       <property name="minimumSize"><size><width>80</width><height>44</height></size></property>
       <property name="text"><string>ON</string></property>
       <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
       <property name="command_text_string" stdset="0"><string>M64 P3</string></property>
      </widget>
     </item>
     <item row="0" column="2">
      <widget class="ActionButton" name="btn_sol_ts_off">
       <property name="minimumSize"><size><width>80</width><height>44</height></size></property>
       <property name="text"><string>OFF</string></property>
       <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
       <property name="command_text_string" stdset="0"><string>M65 P3</string></property>
      </widget>
     </item>
     <item row="1" column="0"><widget class="QLabel" name="sol_lbl_blow"><property name="text"><string>Chip blow-off (P4)</string></property></widget></item>
     <item row="1" column="1">
      <widget class="ActionButton" name="btn_sol_blow_on">
       <property name="minimumSize"><size><width>80</width><height>44</height></size></property>
       <property name="text"><string>ON</string></property>
       <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
       <property name="command_text_string" stdset="0"><string>M64 P4</string></property>
      </widget>
     </item>
     <item row="1" column="2">
      <widget class="ActionButton" name="btn_sol_blow_off">
       <property name="minimumSize"><size><width>80</width><height>44</height></size></property>
       <property name="text"><string>OFF</string></property>
       <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
       <property name="command_text_string" stdset="0"><string>M65 P4</string></property>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QLabel" name="sol_lbl_trel">
       <property name="text"><string>TOOL RELEASE (P0) — DROPS TOOL. ⚠ fires *63+*64+*65 together; docs map those to 3 separate functions — UNVERIFIED</string></property>
       <property name="styleSheet"><string notr="true">color: rgb(255,120,120);</string></property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QPushButton" name="btn_sol_trel_on">
       <property name="minimumSize"><size><width>80</width><height>44</height></size></property>
       <property name="text"><string>ON (5s)</string></property>
       <property name="styleSheet"><string notr="true">color: rgb(255,120,120);</string></property>
      </widget>
     </item>
     <item row="2" column="2">
      <widget class="ActionButton" name="btn_sol_trel_off">
       <property name="minimumSize"><size><width>80</width><height>44</height></size></property>
       <property name="text"><string>OFF</string></property>
       <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
       <property name="command_text_string" stdset="0"><string>M65 P0</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="sol_note">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Spindle CW/CCW (R6/R7) and drive-enable (R5) are RELAY coils, not solenoids, and are driven by the interlock logic — not button-commandable. Live states: Limits tab.</string></property>
     <property name="styleSheet"><string notr="true">color: #888; font: 9pt; padding: 4px 6px;</string></property>
    </widget>
   </item>
   <item>
    <spacer name="probeSpacer">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="sizeHint" stdset="0"><size><width>10</width><height>40</height></size></property>
    </spacer>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget><class>ActionButton</class><extends>QPushButton</extends><header>qtvcp.widgets.action_button</header></customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
