<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <!-- PLACEHOLDER (pending feature a): on-screen MPG axis + speed indicator.
      Plain-widget stub. Real data comes from mpgjog.comp on the machine HAL;
      drive lbl_mpg_axis / lbl_mpg_speed from the handler or wire in postgui.hal. -->
 <class>pageMpg</class>
 <widget class="QWidget" name="pageMpg">
  <layout class="QFormLayout" name="mpgForm">
   <item row="0" column="0"><widget class="QLabel" name="lbl_mpg_hdr">
    <property name="text"><string>MPG PENDANT</string></property>
    <property name="styleSheet"><string notr="true">font: 75 16pt; padding: 8px;</string></property></widget></item>
   <item row="1" column="0"><widget class="QLabel" name="cap_mpg_axis"><property name="text"><string>Selected axis</string></property></widget></item>
   <item row="1" column="1"><widget class="QLabel" name="lbl_mpg_axis">
    <property name="text"><string>—</string></property>
    <property name="styleSheet"><string notr="true">color: rgb(255,220,0); font: 75 20pt "Courier 10 Pitch";</string></property></widget></item>
   <item row="2" column="0"><widget class="QLabel" name="cap_mpg_speed"><property name="text"><string>Speed / increment</string></property></widget></item>
   <item row="2" column="1"><widget class="QLabel" name="lbl_mpg_speed">
    <property name="text"><string>—</string></property>
    <property name="styleSheet"><string notr="true">color: rgb(255,220,0); font: 75 20pt "Courier 10 Pitch";</string></property></widget></item>
   <item row="3" column="0"><widget class="QLabel" name="cap_mpg_reason"><property name="text"><string>Status</string></property></widget></item>
   <item row="3" column="1"><widget class="QLabel" name="lbl_mpg_reason">
    <property name="text"><string>—</string></property>
    <property name="wordWrap"><bool>true</bool></property>
    <property name="styleSheet"><string notr="true">color: rgb(255,220,0); font: 75 13pt "Courier 10 Pitch"; background: rgb(40,40,40); padding: 6px;</string></property></widget></item>
   <item row="4" column="0"><widget class="QLabel" name="note_mpg">
    <property name="wordWrap"><bool>true</bool></property>
    <property name="text"><string>Wheel jogs the selected axis (LinuxCNC jog: accel/decel + soft limits). Button TAP = next axis X-Y-Z-A-C. Button HOLD + wheel = speed: left 1x / mid 5x / right 10x. Per detent: 0.01/0.05/0.5 mm linear, 0.01/0.05/0.1 deg on A/C. A depressed limit switch only blocks the wheel TOWARD it; the Status line above names the block.</string></property></widget></item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
