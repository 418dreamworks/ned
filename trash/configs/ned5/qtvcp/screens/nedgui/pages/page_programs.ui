<?xml version="1.0" encoding="UTF-8"?>
<!-- PROGRAMS: one button per routine. Add a routine = add an ActionButton whose
     command_text_string is its o-word call. Solenoid on/off lives on its own
     Solenoids screen, NOT here. -->
<ui version="4.0">
 <class>pagePrograms</class>
 <widget class="QWidget" name="pagePrograms">
  <layout class="QVBoxLayout" name="progLayout">
   <item>
    <widget class="QLabel" name="prog_hdr">
     <property name="text"><string>PROGRAMS</string></property>
     <property name="styleSheet"><string notr="true">font: 75 15pt; padding: 6px;</string></property>
    </widget>
   </item>
   <item>
    <widget class="ActionButton" name="btn_find_ztop">
     <property name="minimumSize"><size><width>0</width><height>72</height></size></property>
     <property name="text"><string>FIND TOOL PROBE Z</string></property>
     <property name="styleSheet"><string notr="true">font: 75 14pt;</string></property>
     <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
     <property name="command_text_string" stdset="0"><string>o&lt;find_puck_top&gt; call</string></property>
    </widget>
   </item>
   <item>
    <widget class="ActionButton" name="btn_probe_repeat">
     <property name="minimumSize"><size><width>0</width><height>56</height></size></property>
     <property name="text"><string>PROBE Z x10 (repeatability)</string></property>
     <property name="styleSheet"><string notr="true">font: 75 13pt;</string></property>
     <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
     <property name="command_text_string" stdset="0"><string>o&lt;probe_z_repeat&gt; call</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="lbl_ztop_result">
     <property name="text"><string>Z_top: (not measured)</string></property>
     <property name="styleSheet"><string notr="true">color: rgb(0,255,180); font: 75 15pt "Courier 10 Pitch"; padding: 6px;</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="prog_note">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Retracts the probe (assert OFF), deploys it (assert ON), probes Z-down, stores Z_top in #5211 — persistent across restarts via the .var file, not in params. Jog the tool roughly over the probe first (within ~15 mm).</string></property>
     <property name="styleSheet"><string notr="true">color: #888; font: 9pt; padding: 2px 6px;</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="lbl_head_read">
     <property name="text"><string>head: (read runs with homing)</string></property>
     <property name="styleSheet"><string notr="true">color: rgb(0,255,180); font: 75 14pt "Courier 10 Pitch"; padding: 4px 6px;</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="prog_ph_hdr">
     <property name="text"><string>(placeholders)</string></property>
     <property name="styleSheet"><string notr="true">color: #777; padding: 10px 6px 2px 6px;</string></property>
    </widget>
   </item>
   <item>
    <widget class="QPushButton" name="btn_prog_ph1">
     <property name="minimumSize"><size><width>0</width><height>44</height></size></property>
     <property name="enabled"><bool>false</bool></property>
     <property name="text"><string>— find probe rim / centre —</string></property>
    </widget>
   </item>
   <item>
    <widget class="QPushButton" name="btn_prog_ph2">
     <property name="minimumSize"><size><width>0</width><height>44</height></size></property>
     <property name="enabled"><bool>false</bool></property>
     <property name="text"><string>— find A zero (square head) —</string></property>
    </widget>
   </item>
   <item>
    <spacer name="progSpacer">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="sizeHint" stdset="0"><size><width>10</width><height>60</height></size></property>
    </spacer>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget><class>ActionButton</class><extends>QPushButton</extends><header>qtvcp.widgets.action_button</header></customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
