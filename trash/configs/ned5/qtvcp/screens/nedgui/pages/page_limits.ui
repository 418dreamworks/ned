<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <!-- STATUS / DIAGNOSTICS page. Every LED has halpin_option=true + pin_name, which
      makes a HAL input bit  nedgui.<pin_name>  , netted in ned5/postgui_iron.hal.
      Limits: red, lit = AT that limit (signals are TRUE-at-limit).
      Interlocks: green, lit = OK (signals are TRUE-when-ok).
      Solenoids: amber, lit = energized. -->
 <class>pageLimits</class>
 <widget class="QWidget" name="pageLimits">
  <layout class="QVBoxLayout" name="limLayout">
   <item>
    <widget class="QGroupBox" name="grpLimits">
     <property name="title"><string>HARD LIMITS  (red = at limit)</string></property>
     <layout class="QGridLayout" name="gridLimits">
      <item row="0" column="0"><widget class="LED" name="led_lim_x_aft"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>255</red><green>40</green><blue>40</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>lim-x-aft</string></property></widget></item>
      <item row="0" column="1"><widget class="QLabel" name="l_x_aft"><property name="text"><string>X aft</string></property></widget></item>
      <item row="0" column="2"><widget class="LED" name="led_lim_x_fore"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>255</red><green>40</green><blue>40</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>lim-x-fore</string></property></widget></item>
      <item row="0" column="3"><widget class="QLabel" name="l_x_fore"><property name="text"><string>X fore</string></property></widget></item>
      <item row="1" column="0"><widget class="LED" name="led_lim_y_sb"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>255</red><green>40</green><blue>40</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>lim-y-sb</string></property></widget></item>
      <item row="1" column="1"><widget class="QLabel" name="l_y_sb"><property name="text"><string>Y sb</string></property></widget></item>
      <item row="1" column="2"><widget class="LED" name="led_lim_y_port"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>255</red><green>40</green><blue>40</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>lim-y-port</string></property></widget></item>
      <item row="1" column="3"><widget class="QLabel" name="l_y_port"><property name="text"><string>Y port</string></property></widget></item>
      <item row="2" column="0"><widget class="LED" name="led_lim_z_bot"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>255</red><green>40</green><blue>40</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>lim-z-bot</string></property></widget></item>
      <item row="2" column="1"><widget class="QLabel" name="l_z_bot"><property name="text"><string>Z lower</string></property></widget></item>
      <item row="2" column="2"><widget class="LED" name="led_lim_z_top"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>255</red><green>40</green><blue>40</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>lim-z-top</string></property></widget></item>
      <item row="2" column="3"><widget class="QLabel" name="l_z_top"><property name="text"><string>Z upper</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="grpInter">
     <property name="title"><string>INTERLOCKS  (green = OK)</string></property>
     <layout class="QGridLayout" name="gridInter">
      <item row="0" column="0"><widget class="LED" name="led_il_estop"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>40</red><green>220</green><blue>40</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>il-estop</string></property></widget></item>
      <item row="0" column="1"><widget class="QLabel" name="l_il_estop"><property name="text"><string>E-stop released</string></property></widget></item>
      <item row="0" column="2"><widget class="LED" name="led_il_air"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>40</red><green>220</green><blue>40</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>il-air</string></property></widget></item>
      <item row="0" column="3"><widget class="QLabel" name="l_il_air"><property name="text"><string>Air OK</string></property></widget></item>
      <item row="1" column="0"><widget class="LED" name="led_il_sptemp"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>40</red><green>220</green><blue>40</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>il-sptemp</string></property></widget></item>
      <item row="1" column="1"><widget class="QLabel" name="l_il_sptemp"><property name="text"><string>Spindle-temp/chain (*39) OK</string></property></widget></item>
      <item row="1" column="2"><widget class="LED" name="led_il_toollock"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>40</red><green>220</green><blue>40</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>il-toollock</string></property></widget></item>
      <item row="1" column="3"><widget class="QLabel" name="l_il_toollock"><property name="text"><string>Tool locked</string></property></widget></item>
      <item row="2" column="0"><widget class="LED" name="led_il_toolrel"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>40</red><green>220</green><blue>40</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>il-toolrel</string></property></widget></item>
      <item row="2" column="1"><widget class="QLabel" name="l_il_toolrel"><property name="text"><string>Tool released</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QFrame" name="divider"><property name="frameShape"><enum>QFrame::HLine</enum></property></widget>
   </item>
   <item>
    <widget class="QGroupBox" name="grpSol">
     <property name="title"><string>SOLENOIDS / OUTPUTS  (amber = energized)</string></property>
     <layout class="QGridLayout" name="gridSol">
      <item row="0" column="0"><widget class="LED" name="led_sol_toolsetter"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>255</red><green>170</green><blue>0</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>sol-toolsetter</string></property></widget></item>
      <item row="0" column="1"><widget class="QLabel" name="l_sol_toolsetter"><property name="text"><string>Toolsetter deploy</string></property></widget></item>
      <item row="0" column="2"><widget class="LED" name="led_sol_blowoff"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>255</red><green>170</green><blue>0</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>sol-blowoff</string></property></widget></item>
      <item row="0" column="3"><widget class="QLabel" name="l_sol_blowoff"><property name="text"><string>Chip blow-off</string></property></widget></item>
      <item row="1" column="0"><widget class="LED" name="led_sol_toolrel"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>255</red><green>170</green><blue>0</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>sol-toolrel</string></property></widget></item>
      <item row="1" column="1"><widget class="QLabel" name="l_sol_toolrel"><property name="text"><string>HQD tool release</string></property></widget></item>
      <item row="1" column="2"><widget class="LED" name="led_sol_cw"><property name="minimumSize"><size><width>26</width><height>26</height></size></property><property name="diameter"><number>20</number></property><property name="color"><color alpha="255"><red>255</red><green>170</green><blue>0</blue></color></property><property name="halpin_option" stdset="0"><bool>true</bool></property><property name="pin_name" stdset="0"><string>sol-cw</string></property></widget></item>
      <item row="1" column="3"><widget class="QLabel" name="l_sol_cw"><property name="text"><string>Spindle CW</string></property></widget></item>
