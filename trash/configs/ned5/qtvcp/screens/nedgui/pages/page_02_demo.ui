<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <!--
   page_02_demo.ui : WORKED EXAMPLE of "how to add a page".
   This whole tab exists only to show the pattern. It uses plain Qt widgets
   (no qtvcp/HAL widgets), so it needs no customwidgets block. To make it a
   tab, one line was added to PAGES in nedgui_handler.py:
        ("Page 2", "page_02_demo.ui"),
   Delete this file plus that line to remove the tab. That is the mechanism.
 -->
 <class>pageDemo</class>
 <widget class="QWidget" name="pageDemo">
  <layout class="QVBoxLayout" name="demoLayout">
   <item>
    <widget class="QLabel" name="demo_title">
     <property name="text"><string>This is Page 2</string></property>
     <property name="alignment"><set>Qt::AlignCenter</set></property>
     <property name="styleSheet"><string notr="true">font: 75 24pt; padding: 20px;</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="demo_body">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Added by dropping this .ui into pages/ and adding one line to the PAGES list in nedgui_handler.py. Copy this file to start a new page.</string></property>
     <property name="alignment"><set>Qt::AlignHCenter|Qt::AlignTop</set></property>
    </widget>
   </item>
   <item>
    <widget class="QPushButton" name="demo_button">
     <property name="text"><string>A plain button (does nothing)</string></property>
    </widget>
   </item>
   <item>
    <spacer name="demoSpacer">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="sizeHint" stdset="0"><size><width>10</width><height>200</height></size></property>
    </spacer>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
