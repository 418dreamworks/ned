<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <!-- page_cal.ui : temporary HEAD CALIBRATION page. Use AFTER homing.
      A: incremental +/-1 deg. C: incremental +/-45 deg. Each button issues an
      MDI incremental move (G91 G0 .. G90); LinuxCNC clamps it to the A +/-115 /
      C +/-315 soft limits. A/C are bounded axes, so a +ve->-ve move goes through 0. -->
 <class>pageCal</class>
 <widget class="QWidget" name="pageCal">
  <layout class="QGridLayout" name="calGrid">
   <item row="0" column="0" colspan="4">
    <widget class="QLabel" name="cal_hdr">
     <property name="text"><string>HEAD CALIBRATION  (use after homing)</string></property>
     <property name="styleSheet"><string notr="true">font: 75 15pt; padding: 8px;</string></property>
    </widget>
   </item>

   <item row="1" column="0"><widget class="QLabel" name="cal_lbl_a"><property name="text"><string>A (tilt)</string></property></widget></item>
   <item row="1" column="1">
    <widget class="DROLabel" name="dro_cal_a">
     <property name="styleSheet"><string notr="true">color: rgb(0,255,180); font: 75 22pt "Courier 10 Pitch";</string></property>
     <property name="text"><string>0.000</string></property>
     <property name="Qjoint_number" stdset="0"><number>3</number></property>
     <property name="Qreference_type" stdset="0"><number>0</number></property>
    </widget>
   </item>
   <item row="1" column="2">
    <widget class="ActionButton" name="btn_a_minus">
     <property name="minimumSize"><size><width>90</width><height>56</height></size></property>
     <property name="text"><string>A −1°</string></property>
     <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
     <property name="command_text_string" stdset="0"><string>o&lt;nudge_a&gt; call [-1]</string></property>
    </widget>
   </item>
   <item row="1" column="3">
    <widget class="ActionButton" name="btn_a_plus">
     <property name="minimumSize"><size><width>90</width><height>56</height></size></property>
     <property name="text"><string>A +1°</string></property>
     <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
     <property name="command_text_string" stdset="0"><string>o&lt;nudge_a&gt; call [1]</string></property>
    </widget>
   </item>

   <item row="2" column="0"><widget class="QLabel" name="cal_lbl_c"><property name="text"><string>C (spin)</string></property></widget></item>
   <item row="2" column="1">
    <widget class="DROLabel" name="dro_cal_c">
     <property name="styleSheet"><string notr="true">color: rgb(0,255,180); font: 75 22pt "Courier 10 Pitch";</string></property>
     <property name="text"><string>0.000</string></property>
     <property name="Qjoint_number" stdset="0"><number>5</number></property>
     <property name="Qreference_type" stdset="0"><number>0</number></property>
    </widget>
   </item>
   <item row="2" column="2">
    <widget class="ActionButton" name="btn_c_minus">
     <property name="minimumSize"><size><width>90</width><height>56</height></size></property>
     <property name="text"><string>C −45°</string></property>
     <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
     <property name="command_text_string" stdset="0"><string>o&lt;nudge_c&gt; call [-45]</string></property>
    </widget>
   </item>
   <item row="2" column="3">
    <widget class="ActionButton" name="btn_c_plus">
     <property name="minimumSize"><size><width>90</width><height>56</height></size></property>
     <property name="text"><string>C +45°</string></property>
     <property name="mdi_command_action" stdset="0"><bool>true</bool></property>
     <property name="command_text_string" stdset="0"><string>o&lt;nudge_c&gt; call [45]</string></property>
    </widget>
   </item>

   <item row="3" column="0" colspan="4">
    <spacer name="calSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="sizeHint" stdset="0"><size><width>10</width><height>200</height></size></property></spacer>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget><class>ActionButton</class><extends>QPushButton</extends><header>qtvcp.widgets.action_button</header></customwidget>
  <customwidget><class>DROLabel</class><extends>QLabel</extends><header>qtvcp.widgets.dro_widget</header></customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
