component pso_abs "Parse Yaskawa PSO absolute serial (P<sign><5 multiturn>,<8 within>, 9600 7E1) on a Mesa PktUART into HAL pins";

description """Configures hm2_...pktuart.N RX at 9600 baud, reads frames each servo cycle,
masks each captured byte to 7 bits (7E1 -- parity is the masked-off MSB), and parses the
Yaskawa PSO frame  P<sign><5-digit multiturn>,<8-digit within-turn>  into HAL pins.
R = 2^26 = 67108864 counts/motor-rev; combine as  multiturn*R + within  in the READER
(64-bit) -- multiturn*R overflows s32, so this comp exposes the two fields separately.
Parses whatever axis the R4 mux currently routes onto the UART.
Load:
  loadrt pso_abs names=hm2_7i97.0.pktuart.0
  addf hm2_7i97.0.pktuart.0.receive servo-thread""";

author "ned";
license "GPL";

include "hostmot2-serial.h";

pin out s32 multiturn "last parsed multiturn (signed motor revs)";
pin out u32 within    "last parsed within-turn (0 .. 2^26-1)";
pin out bit valid     "a well-formed frame was parsed THIS cycle";
pin out u32 parsed    "total well-formed frames parsed since load (freshness counter)";
pin out u32 parse_err "frames received that did not parse";
pin out u32 frames    "frames read this cycle";
pin out s32 rxbytes   "bytes read this cycle (negative = error)";
pin out s32 last_err  "last negative return from read/config";
pin out u32 rx_status "raw RX status reg";
pin in  bit reset      "rising edge flushes/resets the PktUART so the NEXT read works";
pin out bit oversize   "TRUE = frames far larger than one 17-char message -> ifdelay too long. THIS FAILS SILENTLY otherwise.";
pin out s32 lastsize   "size of the most recent frame the PktUART handed us (17 = one clean message)";
pin out s32 buflen     "bytes currently in the rolling buffer -- lets us VERIFY a flush emptied it and that it refills";
pin out s32 newbytes   "bytes appended THIS cycle (proves data is still arriving)";
pin in  bit enable     "MUST be TRUE to touch the board. FALSE = do nothing (no llio->read).";

variable char pname[64];
variable char ring[512];
variable int rlen;
variable int prev_reset;
variable int warned_oversize;
variable int decim;
option extra_setup yes;
function receive;

;;

#define BAUDRATE 9600

/* Interframe delay in BIT TIMES -- THE critical setting.
   PSO sends a 17-char message every 40 ms (manual 6.12.5): ~17.7 ms of data then ~22 ms idle.
   The PktUART closes a frame after ifdelay of idle line, so it must sit BETWEEN the
   inter-character time (~0 within a message) and the 22 ms inter-message gap (~211 bit times).
   Measured sweep:  10 -> 1-byte frames (splits mid-message)
                    20 -> 17  (one clean message)  <-- correct
                    40 -> 17  (one clean message)  <-- correct
                   100 -> 769 (glues ~46 messages into one oversized frame)  <-- was the bug
   ifdelay=100 was why only the first read per session ever worked. 30 sits mid-range. */
int ifdelay_p = 30;
RTAPI_MP_INT(ifdelay_p, "PktUART RX interframe delay in bit times");

FUNCTION(receive){
    rtapi_u16 max_frame_length = 1024;
    // CRITICAL: hm2_pktuart_read() issues a DIRECT llio->read. On hm2_eth that is an extra
    // UDP round-trip INSIDE the servo period -- it adds jitter to every cycle and caused
    // following errors on the analog PID joints (X/Y/W) during homing motion. So do nothing
    // at all unless a read is deliberately in progress (machine idle, A/C locked by SEN).
    if (!enable) { valid = 0; decim = 0; return; }
    /* DECIMATE. hm2_pktuart_read() does a DIRECT llio->read = an extra UDP round-trip inside
       the 1 ms servo cycle. At 1 kHz that is what produced "Watchdog has bit!" and the sserial
       local error 13/3 on this board. The PSO message only arrives every 40 ms, so reading
       every 20th cycle (20 ms) is still 2x oversampled and cuts the packet load 20x. */
    if (++decim < 20) { valid = 0; return; }
    decim = 0;
    // Only call hm2_pktuart_read() when the FPGA says a frame is actually waiting.
    // Hammering an empty FIFO every servo cycle is a prime suspect for wedging the RX
    // block (RXBUSY latches high, HASDATA never sets, nothing is ever received again).
    rx_status = hm2_pktuart_get_rx_status(pname);
    newbytes = 0;
    // Only ONE read succeeds per session unless the UART is flushed between reads:
    // after a burst the RX FIFO/frame counter stays stuck and hm2_pktuart_read() then
    // returns nothing (no error). A rising edge here clears it before the next SEN pulse.
    if (reset && !prev_reset) {
        // Clear ONLY our own rolling buffer. Do NOT reconfigure the UART here: an off->on
        // hm2_pktuart_config cycle appears to leave RX dead, after which nothing arrives and
        // the multiturn/within OUT pins simply keep showing the PREVIOUS axis's value -- which
        // looks exactly like "the mux did not switch" but is really stale pin state.
        rlen = 0;
        valid = 0;
        multiturn = 0;   /* zero the OUT pins too, so a stale value cannot masquerade */
        within = 0;      /* as a fresh read after the flush */
    }
    prev_reset = reset ? 1 : 0;
    rtapi_u8  num_frames = 4;
    unsigned char buf[4*1024];
    rtapi_u16 sizes[4];
    int r = hm2_pktuart_read(pname, buf, &num_frames, &max_frame_length, sizes);
    rx_status = hm2_pktuart_get_rx_status(pname);
    newbytes = 0;
    rxbytes = r;
    frames = num_frames;
    valid = 0;
    if (r < 0) { last_err = r; hm2_pktuart_reset(pname); return; }  // clear sticky overrun/false-start
    if (r > 0) {
        // The pack repeats one snapshot continuously, so at 9600 baud each servo cycle only
        // drains a byte or two and message boundaries fall anywhere. Accumulate into a rolling
        // buffer and scan THAT for the newest complete message. `reset` clears it, so after an
        // R4 flip no stale bytes from the other axis can be parsed.
        int i;
        if (num_frames > 0) {
            lastsize = (int)sizes[0];
            /* A PSO message is exactly 17 chars. Anything much bigger means the PktUART did not
               see the ~22 ms inter-message gap, i.e. ifdelay is too long, and it has glued many
               messages into one oversized frame. That produced NO error anywhere -- it just
               quietly yielded unusable frames. Shout about it instead. */
            if (lastsize > 40) {
                oversize = 1;
                if (!warned_oversize) {
                    warned_oversize = 1;
                    rtapi_print_msg(RTAPI_MSG_ERR,
                        "pso_abs: OVERSIZED FRAME %d bytes (expected 17). ifdelay=%d bit times is "
                        "TOO LONG -- the inter-message gap is being missed and messages are being "
                        "concatenated. Use ~20-40.\n", lastsize, ifdelay_p);
                }
            } else {
                oversize = 0;
            }
        }
        for (i = 0; i < r && i < (int)sizeof(buf); i++) {
            if (rlen >= (int)sizeof(ring)) {          // keep the newest half
                int h = sizeof(ring)/2, m;
                for (m = 0; m < h; m++) ring[m] = ring[m+h];
                rlen = h;
            }
            ring[rlen++] = (char)(buf[i] & 0x7f);
            newbytes++;
        }
    }
    buflen = rlen;
    if (newbytes > 0) {           /* only re-scan on NEW data: otherwise `parsed` climbs
                                     every servo cycle and is useless as a freshness signal */
        int k, best = -1;
        for (k = 0; k + 15 <= rlen; k++) {
            int d, ok = 1;
            if (ring[k] != 'P') continue;
            if (ring[k+1] != '+' && ring[k+1] != '-') continue;
            for (d = 0; d < 5; d++) if (ring[k+2+d] < '0' || ring[k+2+d] > '9') { ok = 0; break; }
            if (!ok) continue;
            if (ring[k+7] != ',') continue;
            for (d = 0; d < 8; d++) if (ring[k+8+d] < '0' || ring[k+8+d] > '9') { ok = 0; break; }
            if (!ok) continue;
            best = k;                                  // keep the LAST (freshest)
        }
        if (best >= 0) {
            long mt = 0; unsigned long wt = 0; int d;
            int sign = (ring[best+1] == '-') ? -1 : 1;
            for (d = 0; d < 5; d++) mt = mt*10 + (ring[best+2+d] - '0');
            for (d = 0; d < 8; d++) wt = wt*10 + (ring[best+8+d] - '0');
            multiturn = (rtapi_s32)(sign*mt);
            within = (rtapi_u32)wt;
            valid = 1; parsed++;
        }
    }
}

EXTRA_SETUP(){
    if (prefix[0] != 'h') {
        rtapi_print_msg(RTAPI_MSG_ERR, "pso_abs: use names=hm2_...pktuart.N, not count=\n");
        return -1;
    }
    rtapi_snprintf(pname, sizeof(pname), "%s", prefix);   // COPY -- prefix is not persistent
    hm2_pktuart_config_t cfgrx = {
        .baudrate = BAUDRATE, .filterrate = 0, .drivedelay = 0, .ifdelay = ifdelay_p,
        .flags = HM2_PKTUART_CONFIG_FLUSH | HM2_PKTUART_CONFIG_RXEN
    };
    hm2_pktuart_config_t cfgtx = {
        .baudrate = BAUDRATE, .filterrate = 0, .drivedelay = 0, .ifdelay = 100,
        .flags = HM2_PKTUART_CONFIG_FLUSH
    };
    int r = hm2_pktuart_config(pname, &cfgrx, &cfgtx, 0);
    if (r < 0) {
        rtapi_print_msg(RTAPI_MSG_ERR, "pso_abs: pktuart config failed %d\n", r);
        return -1;
    }
    rtapi_print_msg(RTAPI_MSG_ERR, "pso_abs: %s configured %d baud, RX enabled\n", pname, BAUDRATE);
    return 0;
}
