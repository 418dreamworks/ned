# spin-b.hal — bench-spin the B-axis steppers (7I85S stepgen.00, the 2 mirrored motors).
# NC R11 keeps the 70 V brick powered while drive-enable is LOW, so this spins them
# WITHOUT asserting drive-enable. LinuxCNC must be STOPPED first (one owner per board).
# Run:  halrun -I -f ~/spin-b.hal
# Then at the halcmd: prompt ->  setp hm2_7i97.0.stepgen.00.velocity-cmd 0.3   (spin)
#                                setp hm2_7i97.0.stepgen.00.velocity-cmd 0     (stop)
#                                setp hm2_7i97.0.stepgen.00.velocity-cmd -0.3  (reverse)
#                                exit                                          (quit)

loadrt hostmot2
loadrt hm2_eth board_ip="10.10.10.10" config="num_encoders=6 num_pwmgens=6 num_stepgens=4 num_inmuxs=1 sserial_port_0=0xxxxxxx"
loadrt threads name1=servo period1=1000000
addf hm2_7i97.0.read  servo
addf hm2_7i97.0.write servo

setp hm2_7i97.0.watchdog.timeout_ns 1000000000

# stepgen.00 = B axis. Velocity mode; timing copied from ned.hal section 8.
setp hm2_7i97.0.stepgen.00.step_type       0
setp hm2_7i97.0.stepgen.00.control-type    1
setp hm2_7i97.0.stepgen.00.position-scale  3200
setp hm2_7i97.0.stepgen.00.steplen         2500
setp hm2_7i97.0.stepgen.00.stepspace       2500
setp hm2_7i97.0.stepgen.00.dirsetup        20000
setp hm2_7i97.0.stepgen.00.dirhold         20000
setp hm2_7i97.0.stepgen.00.maxvel          5
setp hm2_7i97.0.stepgen.00.maxaccel        2

start

# Enabled but stationary — command velocity at the prompt to turn.
setp hm2_7i97.0.stepgen.00.enable          1
setp hm2_7i97.0.stepgen.00.velocity-cmd    0
