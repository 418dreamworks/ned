# move-b-180.hal — rotate the B-axis rotary exactly 180 deg, then hold.
# NC R11 keeps the 70 V brick powered with drive-enable LOW, so no enable needed.
# LinuxCNC (and any other halrun) must be STOPPED first — one owner per board.
# Run:  halrun -I -f ~/move-b-180.hal
# At the halcmd: prompt afterwards:
#   setp hm2_7i97.0.stepgen.00.position-cmd 0     -> rotate back 180
#   setp hm2_7i97.0.stepgen.00.position-cmd 360   -> another 180 forward
#   exit                                          -> quit

loadrt hostmot2
loadrt hm2_eth board_ip="10.10.10.10" config="num_encoders=6 num_pwmgens=6 num_stepgens=4 num_inmuxs=1 sserial_port_0=0xxxxxxx"
loadrt threads name1=servo period1=1000000
addf hm2_7i97.0.read  servo
addf hm2_7i97.0.write servo

setp hm2_7i97.0.watchdog.timeout_ns 1000000000

# stepgen.00 = B axis (2 mirrored steppers). POSITION mode, scale in degrees.
setp hm2_7i97.0.stepgen.00.step_type       0
setp hm2_7i97.0.stepgen.00.control-type    0
setp hm2_7i97.0.stepgen.00.position-scale  177.778
setp hm2_7i97.0.stepgen.00.steplen         2500
setp hm2_7i97.0.stepgen.00.stepspace       2500
setp hm2_7i97.0.stepgen.00.dirsetup        20000
setp hm2_7i97.0.stepgen.00.dirhold         20000
setp hm2_7i97.0.stepgen.00.maxvel          20
setp hm2_7i97.0.stepgen.00.maxaccel        40

start
setp hm2_7i97.0.stepgen.00.enable          1
setp hm2_7i97.0.stepgen.00.position-cmd    180
