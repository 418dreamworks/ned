<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ned_controls</class>
 <!-- JOG & PRESETS panel v2, NARROW SQUEEZE (2026-08-02): single 200 px
      column sized for the STOCK JOG PAGE of PB's right sidebar stack
      (probe_basic.ui sidebar_widget > sb_page_1 > jogDisplay, ~200x730).
      All widgets/layouts are declared HERE (no runtime layout insertion
      -> no QGridLayout insertWidget hazard); ned_controls.py only
      findChild()s + connects and logs the wired/missing count loudly.
      Styling: one panel-level QSS on jp_panel using #objectName selectors
      (PB-native dark). Same 21 _JOG_WIDGETS names as the wide v2 layout;
      deltas are geometry only: SPEED buttons stacked vertically, presets
      2 cols x 3 rows, typed-move fields full-width (axis+unit live in the
      placeholder, jp_lbl_*/jp_unit_* labels deleted), CLEAR + GO ABS +
      GO REL stacked full-width, status strip + full-width STOP at the
      bottom. Tap-target fonts >= 9pt. -->
 <widget class="QWidget" name="ned_controls_root">
  <layout class="QVBoxLayout" name="nedLayout">
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <property name="spacing"><number>0</number></property>
   <item>
    <widget class="QFrame" name="jp_panel">
     <property name="styleSheet"><string notr="true">
/* WCS JOG -- Probe Basic native (dark) recipes only; sources:
   probe_basic_dark.qss + probe_basic.ui section frames */
/* no own chrome: the sidebar JOG page is already a framed panel --
   a frame inside a frame wasted width (operator 2026-08-04) */
#jp_panel { border: none; background: transparent; }
#jp_title { border-style: solid; border-color: rgb(176,179,172);
  border-width: 2px; border-radius: 5px; color: white;
  background: rgb(90,90,90); font: 14pt &quot;Probe Basic Bebas Mono&quot;; }
QLabel { background: transparent; color: white;
  font: 12pt &quot;Probe Basic Bebas Mono&quot;; }
#jp_feed_readout { color: white; background-color: rgb(108,108,108);
  border-style: solid; border-color: rgb(116,116,116); border-width: 1px;
  border-radius: 4px; font: 14pt &quot;Probe Basic Bebas Mono&quot;; }
QPushButton { color: white; border-color: black; border-style: solid;
  border-radius: 5px; border-width: 2px;
  background: qlineargradient(spread:pad, x1:0, y1:1, x2:0, y2:0, stop:0 rgba(213, 218, 216, 255), stop:0.169312 rgba(82, 82, 83, 255), stop:0.328042 rgba(72, 70, 73, 255), stop:0.492063 rgba(78, 77, 79, 255), stop:0.703704 rgba(72, 70, 73, 255), stop:0.86 rgba(82, 82, 83, 255), stop:1 rgba(213, 218, 216, 255));
  font-family: &quot;Probe Basic Bebas Mono&quot;; font-size: 15pt; }
QPushButton:disabled { border-color: gray; }
QPushButton:hover { background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
  stop: 0 #A19E9E, stop: 1.0 #5C5959); }
QPushButton:pressed { background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 rgba(85, 85, 238, 255), stop:0.544974 rgba(90, 91, 239, 255), stop:1 rgba(126, 135, 243, 255)); }
QPushButton:checked { background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 rgba(85, 85, 238, 255), stop:0.544974 rgba(90, 91, 239, 255), stop:1 rgba(126, 135, 243, 255)); }
#jp_slow, #jp_medium, #jp_fast, #jp_clear, #jp_stop,
#jp_p_xy0, #jp_p_xyz0, #jp_p_z0, #jp_p_zp10, #jp_p_xy0z10, #jp_p_a0c0 {
  font-family: &quot;Probe Basic Bebas Mono&quot;; font-size: 14pt; }
QLineEdit { color: white; background-color: rgb(108,108,108);
  border-style: solid; border-color: rgb(116,116,116); border-width: 1px;
  border-radius: 4px; selection-color: white;
  selection-background-color: rgb(65,84,255); padding-right: 2px;
  font: 14pt &quot;Probe Basic Bebas Mono&quot;; }
#jp_status_dot { font: 11pt; }
     </string></property>
