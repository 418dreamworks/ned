<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>rack_map</class>
 <!-- RACK MAP user tab (staging/rack_map 2026-08-02). ALL widgets declared
      HERE (house rule: no runtime layout insertion). rack_map.py only
      findChild()s + connects + polls the var file; every wire and every
      refusal is logged loudly. Table params: tool #[4000+N]; per-pocket
      seat/clearance/flags #[4100+N*4]..#[4103+N*4], N=1..15. -->
 <widget class="QWidget" name="rack_map_root">
  <layout class="QVBoxLayout" name="rmLayout">
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <property name="spacing"><number>0</number></property>
   <item>
    <widget class="QFrame" name="rm_panel">
     <property name="styleSheet"><string notr="true">
#rm_panel { background: rgb(24,27,31); border: none; border-radius: 6px; }
QLabel { background: transparent; color: rgb(214,218,222); font: 10pt; }
#rm_title { font: 75 11pt; color: rgb(148,155,163); }
#rm_hdr_pk, #rm_hdr_tool, #rm_hdr_seatx, #rm_hdr_seaty, #rm_hdr_clr,
#rm_hdr_teach { font: 75 9pt; color: rgb(148,155,163); }
QPushButton { background: rgb(43,48,54); color: rgb(214,218,222);
  border: 1px solid rgb(72,79,87); border-radius: 5px; font: 75 9pt; }
QPushButton:pressed { background: rgb(60,66,73); }
QPushButton:disabled { background: rgb(34,38,43);
  color: rgb(105,111,118); border-color: rgb(55,60,66); }
QSpinBox { background: rgb(28,32,36); color: white;
  border: 1px solid rgb(72,79,87); border-radius: 5px;
  padding: 1px 4px; font: 10pt;
  selection-background-color: rgb(232,166,53); }
QSpinBox:focus { border: 1px solid rgb(232,166,53); }
#rm_sync_caption { font: 75 10pt; color: rgb(232,166,53); }
#rm_status { font: 9pt; color: rgb(110,117,124); }
</string></property>
     <layout class="QVBoxLayout" name="rm_v">
      <property name="leftMargin"><number>10</number></property>
      <property name="topMargin"><number>8</number></property>
      <property name="rightMargin"><number>10</number></property>
      <property name="bottomMargin"><number>8</number></property>
      <property name="spacing"><number>4</number></property>
