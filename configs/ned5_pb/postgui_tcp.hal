# ned -- TOOL-TIP (RTCP) postgui. Loaded ONLY by the generated -tcp ini,
# never by the identity config. run5.sh appends it as a second
# POSTGUI_HALFILE; without this file a -tcp launch dies at postgui load.
#
# The kins pin is the distance from the A-axis centreline to the TOOL TIP,
# so it has to track the live tool length. arm.out = head constant + tool
# Z offset. ned_brain writes arm.in0 from configs/params/head_pivot.inc at
# mode apply; motion.tooloffset.z supplies the rest.
#
# With NO tool length applied, tooloffset.z is 0 and arm.out is the bare
# head constant -- so a pivot measured with an unmeasured tool in the
# spindle belongs in head_pivot.inc only until that tool's length is known.
# loadrt for arm moved to postgui_pb.hal -- see the STATELESS A/C HOMING
# block there. This file is CONCATENATED AFTER postgui_pb.hal by run5.sh
# and sum2 can only be loaded once per HAL session.
addf arm servo-thread
addf pivothold.t servo-thread
addf pivothold.and servo-thread
addf pivothold servo-thread
# in0, the head constant, is APPENDED BY run5 from head_pivot.inc when it
# generates postgui_tcp_all.hal -- so it is set here at HAL load, before
# the machine can be powered. It is deliberately NOT written at runtime:
# pivot length is a kinematics term, and stepping it under a live servo
# loop commands dL*sin(A) of Y instantly. ned_brain used to do exactly
# that and jerked the servos on every launch with the head off zero.
net sig-tool-zoff motion.tooloffset.z => arm.in1
# ARM HOLD (2026-10-01): the arm reaches the kins through mux2 `pivothold`
# (loaded in ned5_iron.hal). sel = brain.pivot-hold, TRUE only while the
# brain's tool restore runs M61/G43 in MDI (COORD mode re-solves every joint
# from the tool-tip command each cycle; a 121 mm arm step there = following
# errors on X Y Z X2). in1 is the mux's own output, so sel=1 holds the last
# value; sel=0 passes arm.out live, exactly as before. The brain releases in
# FREE mode, where the step cannot move anything.
# CEILING (adversary 2026-10-01): if the brain dies with pivot-hold TRUE the
# pin keeps its last value and the arm would stay frozen -- wrong TCP geometry
# with no alarm. oneshot pivothold.t limits any hold to 40 s (the brain's
# worst case is 28 s: 5+4+4+5 s of wait_complete + the 10 s FREE wait; the
# ceiling must never fire while the brain still holds, or it releases in
# COORD); the mux selects on (hold AND oneshot.out), so the brain's own
# release is still immediate.
setp pivothold.t.width 40
net sig-pivot-arm   arm.out          => pivothold.in0
net sig-pivot-hold  brain.pivot-hold => pivothold.t.in pivothold.and.in0
net sig-pivot-hold-t pivothold.t.out => pivothold.and.in1
net sig-pivot-sel   pivothold.and.out => pivothold.sel
net sig-pivot-len   pivothold.out    => ned_ac_kins.pivot-length pivothold.in1
# Discrete geometry, not calibrated numbers: azimuth 90 puts the A tilt in
# the YZ plane at C=0, tilt-sign matches the physical A direction to the
# model. Neither is determined by the pivot measurement -- (1-cosA) is even
# in A, so the two-touch solve is blind to the sign.
setp ned_ac_kins.azimuth-offset 90
setp ned_ac_kins.tilt-sign 1
