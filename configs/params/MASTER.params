[joint.z]
# joint_z.inc -- Z vertical. Lifted verbatim from configs/ned/ned.ini [JOINT_2].
# In the 5-axis config this is JOINT_2 (axis Z). Z homes first and to the TOP.
TYPE = LINEAR
MAX_VELOCITY = 169.3
MAX_ACCELERATION = 200.0
FERROR = 12.7
MIN_FERROR = 2.54
MIN_LIMIT = -620.0
MAX_LIMIT = 1.0
