# ================================================================
# ned MASTER PARAMETER FILE -- the single authoritative source for
# every configs/params/*.inc value (task #16, 2026-08-02).
# Edit HERE; then: tools/live/gen_params.py check && ... write
# NOT here: head_zero.inc (written by ned_brain at zero capture).
# [drivetrain] primitives mirror tools/live/ned_params.sh (bench
# scripts still source that file; `check` cross-checks the two).
# ================================================================

[drivetrain]
DRIVE_PPR = 8192  # head Yaskawa servo: reference pulses per MOTOR rev (Pn20E)
GEAR_A = 128.25  # head A (tilt) reduction motor:axis  -- HQD AC-D90-65 spec 1:128.25
GEAR_C = 203.7471  # head C (spin) reduction motor:axis  -- HQD AC-D90-65 spec 1:203.7471
ROT_FULLSTEPS = 200  # rotary-table stepper full steps/rev
ROT_MICROSTEP = 2  # rotary drive microstep
ROT_GEAR = 20  # rotary table reduction stepper:chuck (1:20 worm)
MAXV_DISPLAY = 333.334  # mm/s = 20000 mm/min -- V-slider CEILING (traj/display
MAX_VEL_LIN = 200  # mm/s -- linear-axis top speed AND PID MAX_OUTPUT clamp (the ONLY

[head_gear]
# head_gear.inc -- HAL-readable copy of the head gear ratios, GENERATED from
# [drivetrain] so the SSOT stays tools/live/ned_params.sh (rule 11). Exists so
# postgui can `setp` pso_live's gear pins from the ini instead of a literal.
# #INCLUDE under a [HEAD_GEAR] header.
A_GEAR = @GEAR_A
C_GEAR = @GEAR_C
# direction convention, matches SIGN in tools/live/ned_brain.py
A_SIGN = -1
C_SIGN = 1

[emcmot]
# emcmot.inc -- shared [EMCMOT] body. #INCLUDE'd under an [EMCMOT] header.
# Values lifted verbatim from configs/ned/ned.ini (single source of truth).
EMCMOT = motmod
COMM_TIMEOUT = 1.0
SERVO_PERIOD = 1000000

[traj]
# traj_common.inc -- shared [TRAJ] body (minus COORDINATES, which is per-case:
# XYZAC here vs XYZXBACB in the 8-joint config). #INCLUDE'd under a [TRAJ] header
# AFTER the COORDINATES line. Lifted verbatim from configs/ned/ned.ini.
LINEAR_UNITS = mm
ANGULAR_UNITS = degree
SPINDLES = 1
DEFAULT_LINEAR_VELOCITY = 20
MAX_LINEAR_VELOCITY = @MAXV_DISPLAY
DEFAULT_ANGULAR_VELOCITY = 15
# 45 deg/s FOR B (operator 2026-08-13: "it should be a lot faster ... like 45
# deg a second ... just for B" / "leave A and C as is, change it for B").
# THIS IS THE SHARED ROTARY CEILING AND IT IS ALSO THE ONLY THING THAT WAS
# HOLDING B BACK. B's own [AXIS_B] MAX_VELOCITY is already 90, so B was never
# axis-limited -- it was clamped to 30 here, and a G0 B move ran at 30 deg/s.
# A AND C DO NOT MOVE. They cap themselves at [AXIS_A]/[AXIS_C] MAX_VELOCITY
# = 30, and LinuxCNC takes the lower of the axis limit and this ceiling, so
# raising the ceiling cannot speed them up. There is no per-axis TRAJ angular
# limit to set -- the axis sections ARE the per-axis limits.
MAX_ANGULAR_VELOCITY = 45
# ---- TRAJECTORY PLANNER LOOKAHEAD -----------------------------------------
# ned had NO [TRAJ] TP settings at all, so it ran on LinuxCNC's defaults --
# and the default lookahead is 50 segments. The manual gives the sizing
# formula (docs/linuxcnc/manual/config/ini-config.html:1530):
#     n = v_max / (2.0 * a_max * t_c)      t_c = servo period = 0.001 s
# and says outright: "If during testing, you notice strange slowdowns and
# can't figure out where they come from, first try increasing this depth."
# For this machine that formula asks for:
#     X/Y  200 mm/s  / 200 mm/s^2  ->  500
#     Z    169.3     / 200         ->  423
#     B     90 deg/s /  30 deg/s^2 -> 1500   <- worst, because its accel is
#                                              lowest, so its ramp is longest
# 50 was 10-30x too shallow for every axis. THAT is why the T12 groove --
# 3620 back-to-back B-only blocks of 2.000 deg -- never reached its
# commanded rate, and why raising F did nothing.
# WHY NOT JUST RAISE ACCELERATION: B is two steppers on a 1:20 worm with no
# encoder (operator 2026-08-13: "i don't want to raise acceleration because
# steppers die silently ... until i have encoders, we can't raise accel").
# Lookahead costs no torque and cannot stall anything.
# 500 FIRST, NOT 1500. The only real cost is realtime headroom -- deeper
# lookahead is more work per servo cycle and this Pi already emits
# "Unexpected realtime delay on task 0". Step up one value per run and
# revert the moment that count rises.
ARC_BLEND_ENABLE = 1
ARC_BLEND_FALLBACK_ENABLE = 0
# MEASURED 2026-08-14, AND IT IS NOT THE LEVER. b_rate_test.ngc drives four
# 180 deg sweeps that differ only in block size. Result, deg/s, commanded 45:
#     depth  500 -> 2deg 5.45   1deg 3.87   10deg 11.95   one-move 28.18
#     depth 1500 -> 2deg 5.46   1deg 3.87   10deg 11.96   one-move 28.29
# Identical, and 1500 added ZERO "Unexpected realtime delay" lines, so CPU was
# never the constraint either. Every short-block figure is almost exactly half
# of sqrt(2*a*d) -- the average of a triangular accelerate-then-decelerate
# profile -- which is what a full STOP at every block boundary looks like.
# The planner is not blending these rotary-only moves at all, whatever the
# lookahead depth. Back to the shipped default; the number stays written down
# so nobody re-runs this experiment.
ARC_BLEND_OPTIMIZATION_DEPTH = 50
ARC_BLEND_GAP_CYCLES = 4
ARC_BLEND_RAMP_FREQ = 100
NO_FORCE_HOMING = 0
# BOOT AT THE LAST SESSION'S COORDINATES, natively (2026-08-10).
# taskintf.cc:1673-1730: joint pos_fb is written here at shutdown and
# restored via emcJointSetMotorOffset at startup. Replaces the Python
# stored_home.json declare for XYZ. It restores A/C too -- no per-joint
# opt-out exists -- which is harmless ONLY because A/C are
# HOME_ABSOLUTE_ENCODER=2: the first home overwrites the offset from the
# live pso pin and cannot move the head. Under =1 a stored number
# becomes travel; that is the 2026-08-07 C swing. Never set A/C to =1.
POSITION_FILE = position.txt

[spindle0]
# spindle_0.inc -- shared [SPINDLE_0] body. #INCLUDE'd under a [SPINDLE_0] header.
# Lifted verbatim from configs/ned/ned.ini (pwmgen.04 -> +/-10 V to the VFD).
MAX_FORWARD_VELOCITY = 18000
MIN_FORWARD_VELOCITY = 1000
MAX_REVERSE_VELOCITY = 18000

[display]
# display_common.inc -- shared [DISPLAY] body (minus the DISPLAY= GUI selector,
# which is per-config). #INCLUDE'd under a [DISPLAY] header, AFTER the DISPLAY=
# line. Lifted verbatim from configs/ned/ned.ini.
CYCLE_TIME = 0.05
POSITION_OFFSET = RELATIVE
POSITION_FEEDBACK = ACTUAL
# 200%: the operator ran out of override on the kakeya groove and the log
# shows it pinned -- "OVR F: 150 -> 150" over and over (2026-08-13).
MAX_FEED_OVERRIDE = 2.0
MAX_SPINDLE_OVERRIDE = 2.0
MIN_SPINDLE_OVERRIDE = 0.2
INTRO_GRAPHIC = linuxcnc.gif
INTRO_TIME = 2
PROGRAM_PREFIX = /home/brains/linuxcnc/nc_files
INCREMENTS = 0.01 mm, 0.05 mm, 0.1 mm, 0.5 mm, 1 mm
SPINDLES = 1
DEFAULT_LINEAR_VELOCITY = 20
MAX_LINEAR_VELOCITY = @MAXV_DISPLAY

[rs274ngc]
# rs274ngc.inc -- shared [RS274NGC] body (minus the per-config PARAMETER_FILE).
# #INCLUDE'd under an [RS274NGC] header. SUBROUTINE_PATH is relative to the
# config dir; configs/ned5 sits at the same depth as configs/ned so it resolves
# identically. Lifted verbatim from configs/ned/ned.ini.
SUBROUTINE_PATH = ../../nc_files/subroutines

[puck]
# puck.inc -- SINGLE SOURCE for the tool-probe ("puck") LOCATION.  [PUCK] section.
# G-code CANNOT rewrite an INI, so the checkpoint routines READ the seeds here and
# LOG their refined results to puck_result.txt (in the config dir) for you to paste
# back in. Nothing here is duplicated in any other file (CLAUDE.md rule 11).
#
#   APPROX_ABOVE  how far above the top to start CP1's down-probe (safe gap).
#   Z_TOP, CENTER_X, CENTER_Y  last measured (CP1/CP2 write to persistent params
#                              #5211/#5212/#5213 for the live run; update these from
#                              puck_result.txt so the next session seeds well).
APPROX_ABOVE = 10.0    # mm, safe start gap above the puck top for CP1
Z_TOP        = 0.0     # mm, measured top-touch spindle-Z reference (from CP1 log)
CENTER_X     = 0.0     # mm, measured puck center X (from CP2 log)
CENTER_Y     = 0.0     # mm, measured puck center Y (from CP2 log)

[axis.x]
# axis_x.inc -- shared [AXIS_X] body (Cartesian limits/velocity). Lifted verbatim
# from configs/ned/ned.ini. #INCLUDE under an [AXIS_X] header.
# MAX_VELOCITY: WRITTEN by tools/live/ned_params.sh (MAX_VEL_LIN) -- edit THERE, never here.
MAX_VELOCITY = @MAX_VEL_LIN
MAX_ACCELERATION = 200.0
# LIMITS DISABLED 2026-08-07 (operator: "disable all axis limits for now").
# An axis limit bounds the TOOL TIP, not the carriage; under ned_ac_kins
# the tip sits up to L*(1-cos A) above the joint, so a joint-sized number
# here refused most of Z. Real fix = limits as a function of L_tool.
# The JOINT limits below are untouched and still stop the machine.
MIN_LIMIT = -5042.725
MAX_LIMIT = 1001

[axis.y]
# axis_y.inc -- shared [AXIS_Y] body. Lifted verbatim from configs/ned/ned.ini.
# MAX_VELOCITY: WRITTEN by tools/live/ned_params.sh (MAX_VEL_LIN) -- edit THERE, never here.
MAX_VELOCITY = @MAX_VEL_LIN
MAX_ACCELERATION = 200.0
# LIMITS DISABLED 2026-08-07 (operator: "disable all axis limits for now").
# An axis limit bounds the TOOL TIP, not the carriage; under ned_ac_kins
# the tip sits up to L*(1-cos A) above the joint, so a joint-sized number
# here refused most of Z. Real fix = limits as a function of L_tool.
# The JOINT limits below are untouched and still stop the machine.
MIN_LIMIT = -2787
MAX_LIMIT = 1001

[axis.z]
# axis_z.inc -- shared [AXIS_Z] body. Lifted verbatim from configs/ned/ned.ini.
MAX_VELOCITY = 169.3
MAX_ACCELERATION = 200.0
# LIMITS DISABLED 2026-08-07 (operator: "disable all axis limits for now").
# An axis limit bounds the TOOL TIP, not the carriage; under ned_ac_kins
# the tip sits up to L*(1-cos A) above the joint, so a joint-sized number
# here refused most of Z. Real fix = limits as a function of L_tool.
# The JOINT limits below are untouched and still stop the machine.
MIN_LIMIT = -1620
MAX_LIMIT = 1001

[axis.a]
# axis_a.inc -- shared [AXIS_A] body (swivel-head TILT about X/W, degrees).
# A soft limit is DISABLED (see below); JOINT_4 still holds +/-115 deg.
# NOTE: LinuxCNC enforces soft limits only AFTER the axis is homed, and they are
# only ABSOLUTE if home was set to the true head angle -- see docs/gui.md.
# 2026-08-16: 2 -> 4 deg/s2, operator "lets double it to 4". ACCELERATION
# was the cap on A's G0, not MAX_VELOCITY 30: at 2 deg/s2 reaching 30 needed
# 225 deg and A has only 230 deg of travel, so 30 was never reached and every
# move ran a triangular profile. Time scales 1/sqrt(a): 90 deg goes 13.4->9.5 s.
# C is deliberately LEFT at 2 -- only A was asked for and only A was reasoned
# about. STEPGEN_MAXACCEL 450 is nowhere near limiting either.
MAX_VELOCITY = 30
MAX_ACCELERATION = 4
# LIMITS DISABLED 2026-08-07 (operator: "disable all axis limits for now").
# An axis limit bounds the TOOL TIP, not the carriage; under ned_ac_kins
# the tip sits up to L*(1-cos A) above the joint, so a joint-sized number
# here refused most of Z. Real fix = limits as a function of L_tool.
# The JOINT limits below are untouched and still stop the machine.
MIN_LIMIT = -3600
MAX_LIMIT = 3600

[axis.c]
# axis_c.inc -- shared [AXIS_C] body (swivel-head SPIN about Z, degrees).
# C soft limit is DISABLED (see below); JOINT_5 still holds +/-315 deg.
# NOTE: enforced only AFTER homing, and absolute only if home = true head angle.
# Bounded (NOT a wrapping/rollover axis) so a +ve->-ve move interpolates through 0.
MAX_VELOCITY = 30
MAX_ACCELERATION = 2
# LIMITS DISABLED 2026-08-07 (operator: "disable all axis limits for now").
# An axis limit bounds the TOOL TIP, not the carriage; under ned_ac_kins
# the tip sits up to L*(1-cos A) above the joint, so a joint-sized number
# here refused most of Z. Real fix = limits as a function of L_tool.
# The JOINT limits below are untouched and still stop the machine.
MIN_LIMIT = -3600
MAX_LIMIT = 3600

[joint.x1]
# joint_x1.inc -- X gantry side 1. Lifted verbatim from configs/ned/ned.ini [JOINT_0].
# In the 5-axis config this is JOINT_0 (axis X). Servo params (PID/scale) are used
# by the real ned.hal; the ned5 SIM loopback HAL ignores them.
TYPE = LINEAR
# MAX_VELOCITY + MAX_OUTPUT: WRITTEN by tools/live/ned_params.sh (MAX_VEL_LIN) -- edit THERE, never here.
MAX_VELOCITY = @MAX_VEL_LIN
MAX_ACCELERATION = 200.0
FERROR = 25.4
MIN_FERROR = 12.7
MIN_LIMIT = -4042.725
MAX_LIMIT = 1.0
P = 15.878
I = 6.4276
D = 0.0
FF0 = 0.0
FF1 = 0.995816
FF2 = 0.002414
BIAS = 0.860
DEADBAND = 0.005
MAX_OUTPUT = @MAX_VEL_LIN
INPUT_SCALE  = 200.0
OUTPUT_SCALE = 356.5
HOME = 0.0
HOME_OFFSET = 5.0
HOME_SEARCH_VEL = 64.0
HOME_LATCH_VEL = 1.666
HOME_FINAL_VEL = 6.35
# +1 NOT -1 (2026-07-31): negative = synchronized-final-move marker, and LinuxCNC
# BARS joint-jogging such joints unhomed (ini-homing.adoc:269) -- operator needs
# unhomed X jog. Anti-racking is carried by the MPG wiring instead: X-select
# drives joints 0 AND 3 with identical counts+scale (postgui_pb.hal), and the
# on-screen per-joint jog buttons are hidden.
HOME_SEQUENCE = -2
HOME_USE_INDEX = NO
HOME_IGNORE_LIMITS = YES

